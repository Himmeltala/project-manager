{
  "name": "project-manager",
  "version": "3.3.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "make": "npm run build && set ELECTRON_MIRROR=https://cdn.npmmirror.com/binaries/electron/&& electron-forge make",
    "make:dir": "npm run build && set ELECTRON_MIRROR=https://cdn.npmmirror.com/binaries/electron/&& electron-forge make --skip-package",
    "pack": "npm run build && set ELECTRON_MIRROR=https://cdn.npmmirror.com/binaries/electron/&& electron-forge package && node scripts/copy-out.js",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"electron/**/*.ts\" \"*.ts\"",
    "lint": "eslint src/ --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src/ --fix --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "lodash-es": "^4.18.1",
    "moment": "^2.30.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@eslint/js": "^9.39.5",
    "@types/iconv-lite": "^0.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.3",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^42.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-local": "file:.eslint-plugin-local",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^3.3.5"
  }
}
