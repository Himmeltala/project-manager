{
  "name": "project-manager",
  "version": "3.3.1",
  "description": "Windows 桌面工具，用于管理多个项目的启动、停止、构建、SVN 更新等操作",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --win --x64",
    "pack:dir": "npm run build && electron-builder --win --x64 --dir",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"electron/**/*.ts\" \"*.ts\" \"assets/*.json\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "element-plus": "^2.6.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "prettier": "^3.8.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.8",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.7"
  }
}
