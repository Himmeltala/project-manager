[
  {
    "key": "interface",
    "label": "界面",
    "groups": [
      {
        "label": "主题",
        "settings": [
          {
            "key": "theme",
            "label": "界面主题",
            "type": "combo",
            "default": "dark",
            "options": [
              {
                "label": "暗色主题",
                "value": "dark"
              },
              {
                "label": "亮色主题",
                "value": "light"
              }
            ],
            "description": "选择程序整体外观主题，暗色护眼、亮色清晰"
          }
        ]
      },
      {
        "label": "日志面板",
        "settings": [
          {
            "key": "output.max_lines",
            "label": "最大输出行数",
            "type": "spinbox",
            "default": 5000,
            "min": 500,
            "max": 50000,
            "step": 500,
            "description": "超过此行数后自动删除旧行，防止卡顿"
          }
        ]
      },
      {
        "label": "底部面板",
        "settings": [
          {
            "key": "bottom_panel.height",
            "label": "面板高度",
            "type": "spinbox",
            "default": 200,
            "min": 80,
            "max": 800,
            "step": 10,
            "suffix": " 像素",
            "description": "底部输出/通知/任务面板的默认高度，可拖动边框调整"
          }
        ]
      }
    ]
  },
  {
    "key": "process",
    "label": "进程",
    "groups": [
      {
        "label": "端口保护",
        "settings": [
          {
            "key": "protected_ports",
            "label": "保护端口列表",
            "type": "text",
            "default": "",
            "description": "以下端口不会被杀死，系统关键端口 135/445/3389 始终受保护。多个端口用逗号分隔，如 80,443,3306"
          }
        ]
      },
      {
        "label": "后台任务",
        "settings": [
          {
            "key": "tasks.max_concurrency",
            "label": "最大并行任务数",
            "type": "spinbox",
            "default": 5,
            "min": 1,
            "max": 20,
            "step": 1,
            "description": "后台任务最大同时执行数量，增大可提高吞吐但增加系统负载"
          },
          {
            "key": "tasks.max_count",
            "label": "最大历史任务数",
            "type": "spinbox",
            "default": 50,
            "min": 10,
            "max": 500,
            "step": 10,
            "description": "超出上限后自动删除已完成/失败的历史任务，避免堆积"
          }
        ]
      }
    ]
  },
  {
    "key": "notifications",
    "label": "通知",
    "groups": [
      {
        "label": "通用",
        "settings": [
          {
            "key": "notifications.enabled",
            "label": "启用通知",
            "type": "checkbox",
            "default": true,
            "description": "关闭后所有通知类型都不会显示，但后台仍会记录"
          },
          {
            "key": "notifications.max_count",
            "label": "最大通知数",
            "type": "spinbox",
            "default": 100,
            "min": 10,
            "max": 1000,
            "step": 10,
            "description": "超出上限后自动删除最旧的通知，避免堆积"
          }
        ]
      },
      {
        "label": "通知类型",
        "settings": [
          {
            "key": "notifications.show_vcs_remote",
            "label": "远程变更",
            "type": "checkbox",
            "default": true,
            "description": "远程仓库有新提交时通知"
          },
          {
            "key": "notifications.show_local_changes",
            "label": "本地未提交变更",
            "type": "checkbox",
            "default": true,
            "description": "有未提交文件时通知"
          },
          {
            "key": "notifications.show_vcs_conflict",
            "label": "版本冲突",
            "type": "checkbox",
            "default": true,
            "description": "合并冲突时通知"
          },
          {
            "key": "notifications.show_info",
            "label": "一般信息",
            "type": "checkbox",
            "default": true,
            "description": "显示一般性通知，如操作成功、状态变更、连接成功等"
          },
          {
            "key": "notifications.show_warning",
            "label": "警告",
            "type": "checkbox",
            "default": true,
            "description": "显示警告性通知，如项目启动失败、端口占用、操作异常等"
          },
          {
            "key": "notifications.show_error",
            "label": "错误",
            "type": "checkbox",
            "default": true,
            "description": "显示错误性通知，如进程崩溃、配置文件损坏、意外终止等"
          }
        ]
      }
    ]
  },
  {
    "key": "vcs",
    "label": "版本控制",
    "groups": [
      {
        "label": "SVN",
        "settings": [
          {
            "key": "svn.path",
            "label": "SVN 可执行文件路径",
            "type": "text",
            "default": "svn",
            "description": "svn.exe 的完整路径，留空或填 svn 表示使用系统 PATH 中的 svn"
          },
          {
            "key": "svn.tortoise_path",
            "label": "TortoiseSVN 路径",
            "type": "text",
            "default": "",
            "description": "TortoiseProc.exe 的完整路径，留空则自动从 Program Files 目录查找"
          }
        ]
      },
      {
        "label": "远程更新检查",
        "settings": [
          {
            "key": "scheduled_checks.remote_enabled",
            "label": "启用远程检查",
            "type": "checkbox",
            "default": false,
            "description": "开启后按下方间隔定时检查仓库是否有新提交"
          },
          {
            "key": "scheduled_checks.remote_interval_minutes",
            "label": "检查间隔",
            "type": "spinbox",
            "default": 30,
            "min": 5,
            "max": 480,
            "suffix": " 分钟",
            "depends_on": "scheduled_checks.remote_enabled",
            "description": "两次远程检查之间的等待时间"
          }
        ]
      },
      {
        "label": "本地未提交检查",
        "settings": [
          {
            "key": "scheduled_checks.local_enabled",
            "label": "启用本地检查",
            "type": "checkbox",
            "default": false,
            "description": "开启后按下方间隔定时检查项目目录是否有未提交的本地变更"
          },
          {
            "key": "scheduled_checks.local_interval_minutes",
            "label": "检查间隔",
            "type": "spinbox",
            "default": 15,
            "min": 5,
            "max": 480,
            "suffix": " 分钟",
            "depends_on": "scheduled_checks.local_enabled",
            "description": "两次本地检查之间的等待时间"
          }
        ]
      }
    ]
  },
  {
    "key": "terminal",
    "label": "终端",
    "groups": [
      {
        "label": "终端命令列表",
        "settings": [
          {
            "key": "terminal.entries",
            "label": "终端命令配置",
            "type": "entries",
            "default": "[{\"name\":\"Git Bash\",\"path\":\"C:\\\\Program Files\\\\Git\\\\git-bash.exe\",\"args\":\"--cd={path}\",\"init\":\"\"}]",
            "description": "右键菜单终端命令列表，JSON 数组格式。每项包含 name(显示名称) path(程序路径) args(启动参数,{path}替换为项目路径) init(进入目录后执行命令)。示例：[{\"name\":\"Git Bash\",\"path\":\"C:\\\\Program Files\\\\Git\\\\git-bash.exe\",\"args\":\"--cd={path}\",\"init\":\"\"},{\"name\":\"CMD\",\"path\":\"cmd.exe\",\"args\":\"/k\",\"init\":\"cd /d {path}\\nclaude --permission-mode auto\"}]"
          }
        ]
      }
    ]
  },
  {
    "key": "external_programs",
    "label": "外部程序",
    "groups": [
      {
        "label": "配置文件优先级",
        "settings": [
          {
            "key": "buildtool.config_priority",
            "label": "配置文件优先级",
            "type": "priority",
            "default": "{}",
            "description": "自定义右键菜单「打开配置文件」时各构建工具配置文件的查找顺序，排在前面的优先打开"
          }
        ]
      },
      {
        "label": "外部程序列表",
        "settings": [
          {
            "key": "openers",
            "label": "外部程序配置",
            "type": "entries",
            "default": "[{\"name\":\"VS Code\",\"path\":\"code.cmd\",\"args\":\"--new-window {path}\"}]",
            "description": "右键菜单「通过软件打开」和「打开配置文件」子菜单列表。每项包含 name(显示名称) path(程序路径) args(启动参数,{path}替换为项目目录、{file}替换为配置文件路径)。示例：[{\"name\":\"VS Code\",\"path\":\"code.cmd\",\"args\":\"--new-window {path}\"},{\"name\":\"记事本\",\"path\":\"notepad.exe\",\"args\":\"{file}\"}]"
          }
        ]
      }
    ]
  },
  {
    "key": "update",
    "label": "更新",
    "groups": [
      {
        "label": "更新策略",
        "settings": [
          {
            "key": "update.type",
            "label": "检查时机",
            "type": "combo",
            "default": "每次启动",
            "options": [
              {
                "label": "每次启动",
                "value": "每次启动"
              },
              {
                "label": "按频率",
                "value": "频率"
              },
              {
                "label": "手动检查",
                "value": "手动检查"
              }
            ],
            "description": "选择何时自动检查更新，手动检查需点击帮助菜单中的检查更新"
          },
          {
            "key": "update.frequency",
            "label": "检查频率",
            "type": "combo",
            "default": "每天",
            "options": [
              {
                "label": "每天",
                "value": "每天"
              },
              {
                "label": "每三天",
                "value": "每三天"
              },
              {
                "label": "每周",
                "value": "每周"
              },
              {
                "label": "每月",
                "value": "每月"
              },
              {
                "label": "自定义",
                "value": "自定义"
              }
            ],
            "depends_on": "update.type",
            "depends_value": "频率",
            "description": "检查时机设为「按频率」时生效，选择多久检查一次"
          },
          {
            "key": "update.custom_minutes",
            "label": "自定义间隔",
            "type": "spinbox",
            "default": 1440,
            "min": 1440,
            "max": 43200,
            "step": 60,
            "suffix": " 分钟",
            "depends_on": "update.frequency",
            "depends_value": "自定义",
            "description": "频率设为「自定义」时生效，按指定分钟数间隔检查"
          }
        ]
      },
      {
        "label": "更新服务器",
        "settings": [
          {
            "key": "update.url",
            "label": "服务器地址",
            "type": "text",
            "default": "http://11.1.1.179:8099",
            "description": "局域网更新服务器的地址"
          }
        ]
      }
    ]
  }
]
